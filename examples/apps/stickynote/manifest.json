{
  "spec": 1,
  "kind": "app",
  "id": "stickynote",
  "name": "便利贴",
  "version": "0.1.0",
  "description": "异形窗口演示：折角便利贴（clip-path + drop-shadow），内容存 VFS /Notes",
  "authors": ["Emerald"],
  "min_runtime": { "emerald": ">=0.1.0" },
  "permissions": ["vfs:write"],
  "entry": "src/main.rb",
  "contributes": {
    "commands": [{ "id": "stickynote.new", "title": "新建便利贴" }],
    "menus": [{ "path": "应用/工具", "command": "stickynote.new" }]
  },
  "activation": { "on_command": ["stickynote.new"] },
  "window": {
    "singleton": false,
    "default_geometry": { "x": 260, "y": 160, "w": 240, "h": 240 }
  }
}
